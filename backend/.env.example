# ---- LLM (Groq) ----
GROQ_API_KEY=your_groq_api_key_here
GROQ_EXTRACTION_MODEL=gemma2-9b-it
GROQ_CONTEXT_MODEL=llama-3.3-70b-versatile

# ---- Database ----
# Use either Postgres or MySQL. Examples:
# Postgres:
DATABASE_URL=postgresql+psycopg2://aivoa_user:aivoa_pass@localhost:5432/aivoa_complaints
# MySQL (comment the line above and uncomment this one instead):
# DATABASE_URL=mysql+pymysql://aivoa_user:aivoa_pass@localhost:3306/aivoa_complaints

# ---- App ----
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
